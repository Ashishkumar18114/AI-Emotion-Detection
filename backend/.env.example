# Backend configuration example
# Copy this to .env and adjust values as needed

# Server Configuration
PORT=5000
DEBUG=False

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost

# Model Configuration
MODEL_PATH=./emotion_vit_model.pt
EMOTIONS=angry,happy,sad
IMG_SIZE=224

# Device Configuration (cuda or cpu)
DEVICE=cpu
